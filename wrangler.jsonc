{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walnut",
  "main": "src/index.tsx",
  "compatibility_date": "2026-05-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "walnut-assets",
      "preview_bucket_name": "walnut-assets-preview"
    },
    {
      "binding": "BUCKET_BACKUP",
      "bucket_name": "walnut-assets-backup",
      "preview_bucket_name": "walnut-assets-backup-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test_DB",
      "database_id": "1",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PAGE_METRICS",
      "dataset": "walnut_page_metrics"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
